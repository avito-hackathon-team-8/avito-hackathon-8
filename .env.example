POSTGRES_DB=hackathon
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=change-me
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000

JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
JWT_TTL=24h
OTP_TTL=5m
OTP_LENGTH=8

DAILY_TASKS_HTTP_ADDRESS=:8091
DAILY_TASKS_POLL_INTERVAL=1m
DAILY_TASKS_INTERNAL_URL=http://daily-tasks-service:8091

PET_STATE_INTERNAL_URL=http://pet-state-service:8092
PET_STATE_HTTP_ADDRESS=:8092
PET_STATE_KAFKA_TOPIC=pet-state-events-v1

# Empty value uses the container hostname
API_SERVICE_INSTANCE_ID=

KAFKA_BROKERS=kafka:9092

TASK_DEFINITIONS_CONFIG=/app/config/task_definitions.yaml
LEADERBOARD_REWARDS_CONFIG=/app/config/leaderboard_rewards.yaml
LEVEL_REWARDS_CONFIG=/app/config/level_rewards.yaml
